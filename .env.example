# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose

# --- Stripe (Developers -> API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # from `stripe listen` or dashboard webhook
STRIPE_PRICE_ID=price_...                         # your £5.99/month price
STRIPE_PRICE_ID_ANNUAL=price_...                  # optional: your £59.90/year price

# --- Resend ---
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...                   # required only for inbound support email
REMINDER_FROM="RentClock <reminders@yourdomain.co.uk>"
OWNER_NOTIFICATION_EMAIL=owner@example.com        # optional new-member notification recipient

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=change-me-to-something-random

# --- AI SEO + Growth workspace (server-only) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GROWTH_OPENAI_MODEL=gpt-4.1-mini                  # optional override for Growth Autopilot

# --- Growth Autopilot ad-platform credentials (server-only) ---
# Keep these unset until the workspace has been tested in dry-run mode.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_ACCOUNT_ID=
MICROSOFT_ADS_CUSTOMER_ID=

# --- Google Search Console (server-only, read-only OAuth) ---
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=your-google-oauth-client-secret
# Generate once: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# --- DataForSEO keyword research (server-only; credentials from DataForSEO API Access) ---
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
